# Application Environment
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Database & Caches
MONGO_URI=mongodb://localhost:27017/souq_marketplace?replicaSet=rs0
REDIS_URI=redis://localhost:6379

# Authentication Secrets
JWT_ACCESS_SECRET=dev_jwt_access_secret_minimum_32_characters_long_for_security
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_minimum_32_characters_long_for_security
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=dev_cookie_secret_minimum_32_characters_long

# Payment Gateway (Chapa)
CHAPA_SECRET_KEY=CHASECK_TEST-mock_test_key_for_local_development
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-mock_public_key_for_client_side
CHAPA_WEBHOOK_SECRET=dev_webhook_hmac_secret_for_chapa_payloads

# Object Storage (MinIO dev / Cloudflare R2 prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=souq-media
S3_ACCESS_KEY=souq_dev_access
S3_SECRET_KEY=souq_dev_secret_key_12345
S3_PUBLIC_URL=http://localhost:9000/souq-media

# Email (Mailpit dev / Transactional SMTP prod)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SOUQ Marketplace <no-reply@souq.example.com>"

# Admin Default Seed Credentials
ADMIN_EMAIL=admin@souq.test
ADMIN_PASSWORD=admin1234
